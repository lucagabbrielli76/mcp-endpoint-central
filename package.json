{
  "name": "mcp-endpoint-central",
  "version": "0.1.0",
  "description": "MCP server for ManageEngine Endpoint Central (on-premise) REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-endpoint-central": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs && node scripts/smoke-test.mjs --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "undici": "^6.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
