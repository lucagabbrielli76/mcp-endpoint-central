# Base URL of your on-premise Endpoint Central server, no trailing path.
# Example: https://ec-server.corp.local:8383
ENDPOINT_CENTRAL_BASE_URL=

# Static API token. Generate/regenerate in the Endpoint Central console:
# Admin -> Integrations -> API Key Management
#
# Security: generate this from a dedicated, least-privileged service account
# rather than a full admin login. Endpoint Central's on-prem API has no
# OAuth-scope concept of its own — access is governed entirely by the RBAC
# role of the account tied to this token — so a scoped account (read-only
# where possible, limited to the modules this server actually needs) bounds
# the blast radius if the token is ever leaked. Treat this value like a
# password: never commit it, never log it, never return it in a tool result.
ENDPOINT_CENTRAL_API_TOKEN=

# Optional: path to a PEM-encoded CA certificate bundle, needed if your
# server's TLS certificate is issued by an internal/private CA and isn't
# already trusted by the OS/Node's default trust store. Leave unset to use
# the default trust store.
ENDPOINT_CENTRAL_CA_CERT_PATH=

# Optional: default page size for list tools when not specified per-call.
# The server's own hard cap is 1000. Defaults to 50.
ENDPOINT_CENTRAL_DEFAULT_PAGE_LIMIT=50

# Optional: set to "true" to register mutating tools (patch install/uninstall,
# agent install/uninstall/remove, APD task changes, custom-field writes, ...).
# Defaults to false: in read-only mode the write tools are not registered at
# all, so a connected LLM client has no write surface to call — the safest
# setting unless you specifically need remediation actions. Even when enabled,
# every mutating tool additionally requires confirm: true per call.
ENDPOINT_CENTRAL_ENABLE_WRITE_TOOLS=false
